{
  "info": {
    "_postman_id": "9e93bb58-70de-4600-8601-75e47d81d6fa",
    "name": "Oficina Mecanica - Autenticacao Lambda",
    "description": "Autenticacao serverless de clientes por CPF. Atualize lambdaUrl com o endpoint publicado pelo workflow de entrega.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticar cliente ativo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.expect(body.token).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('token', body.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"{{cpf}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{lambdaUrl}}/",
          "host": [
            "{{lambdaUrl}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Valida o CPF, consulta o cliente ativo no RDS e salva o JWT retornado na variavel token."
      }
    },
    {
      "name": "Rejeitar CPF invalido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"11111111111\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{lambdaUrl}}/",
          "host": [
            "{{lambdaUrl}}"
          ],
          "path": [
            ""
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "lambdaUrl",
      "value": "https://SUA_FUNCTION_URL.lambda-url.us-east-1.on.aws"
    },
    {
      "key": "cpf",
      "value": "52998224725"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
